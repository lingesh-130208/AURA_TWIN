# GEMINI_API_KEY: Required for Gemini AI API calls (AURA Copilot & Explanations).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Map & Traffic Providers Configuration (Optional - platform falls back to calibrated Demo Network)
MAP_STYLE_URL=""
MAP_ACCESS_TOKEN=""
TOMTOM_API_KEY=""
HERE_API_KEY=""
ROUTING_PROVIDER="mock"
GEOCODER_PROVIDER="mock"
TRAFFIC_REFRESH_SECONDS="30"

